// Smart Trackpad resources.  The manifest is passed to the linker by CMake,
// the icon and version block are compiled from here.

#include "Resources.h"

IDI_APP_ICON ICON "app.ico"

1 VERSIONINFO    // VS_VERSION_INFO must be the numeric id 1
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x00040004L   // VOS_NT_WINDOWS32
FILETYPE        0x00000001L   // VFT_APP
FILESUBTYPE     0x00000000L   // VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Smart Trackpad"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "SmartTrackpad"
            VALUE "OriginalFilename", "SmartTrackpad.exe"
            VALUE "ProductName",      "Smart Trackpad"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
